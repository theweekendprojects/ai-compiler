{
  "name": "aicompiler-web",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "aicompiler.dev", "custom_domain": true },
    { "pattern": "www.aicompiler.dev", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_WORKER_URL": "https://aivm-worker.mineme-shahriar.workers.dev"
  }
}
